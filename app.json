{
  "expo": {
    "name": "BooksApp",
    "slug": "BooksApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.manuelguido.BooksApp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.manuelguido.BooksApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "GOOGLE_BOOKS_API_KEY": "${EXPO_PUBLIC_GOOGLE_BOOKS_API_KEY}",
      "eas": {
        "projectId": "ec646afa-82bb-48da-809b-b76de556a0d7"
      }
    }
  }
}
