# Configuración de pnpm para Expo + React Native
# Este archivo asegura comportamiento determinístico y compatibilidad

# Modo de instalación: hoisted es necesario para React Native
# ya que muchos paquetes nativos esperan encontrar dependencias en node_modules raíz
node-linker=hoisted

# Auto-instalar peers para evitar warnings y errores de peerDependencies faltantes
auto-install-peers=true

# Usar lockfile estricto para builds reproducibles
frozen-lockfile=false

# Resolver conflictos de peers de forma permisiva (necesario para el ecosistema RN)
strict-peer-dependencies=false

# Shamefully hoist para máxima compatibilidad con el toolchain de React Native
shamefully-hoist=true

# No usar store global para evitar problemas en CI/CD
prefer-offline=false
